{
  "$comment": "VS Code 用。'servers' キーを使う。VS Code はこのファイルとルートの .mcp.json の両方を読むので、ルートには .mcp.json を置かない (二重登録になる、実測済み)。使わないサーバはツールピッカーで切る。記憶は Copilot 組み込みの Memory を使うので memory サーバは置かない。",
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--user-data-dir",
        "${userHome}/.cache/pw-mcp-profile"
      ]
    },
    "playwright-ext": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--extension"]
    },
    "desktop": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@zavora-ai/computer-use-mcp"]
    }
  }
}
